# Copy to .env for local development only; never use these values in production.
# Docker Compose uses these for disposable local containers.
MYSQL_DATABASE=mealminutes_platform
MYSQL_USER=mealminutes_app
MYSQL_PASSWORD=local_dev_only_change_me
MYSQL_ROOT_PASSWORD=local_root_only_change_me
MYSQL_PORT=3306
REDIS_PORT=6379

# Optional local tenant provisioning (local profile only; never reuse in production)
MEALMINUTES_TENANT_PROVISIONING_ENABLED=false
TENANT_DB_ADMIN_JDBC_URL=jdbc:mysql://localhost:3306/mysql?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
TENANT_DB_ADMIN_USERNAME=root
TENANT_DB_ADMIN_PASSWORD=local_root_only_change_me
MEALMINUTES_LOCAL_SECRET_FILE=./.local-secrets/tenant-db-secrets.properties
# Generate a fresh 32-byte Base64 key; do not commit it.
MEALMINUTES_LOCAL_SECRET_KEY=
